# ./setup.sh copies this to .env and replaces DB_PASSWORD.
# To set a password yourself, letters and digits only:
#   od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
# Changing it after the first start does not update the password already stored in Postgres.

# Pinned Immich release. Bump this on purpose. Do not use "release" or "v3".
IMMICH_VERSION=v3.4.0

# Host ports. The family portal already uses 80, 3000, 3001, and 8080.
IMMICH_BIND=0.0.0.0
IMMICH_PORT=2283
TIMELINE_BIND=0.0.0.0
TIMELINE_PORT=2284

# Where this server stores Immich's own library (uploads, thumbnails, previews,
# transcodes). Use a big disk. This directory will grow even for external libraries.
UPLOAD_LOCATION=./data/library

# Postgres must live on a local SSD. Network shares and NFS are not supported.
DB_DATA_LOCATION=./data/postgres

DB_PASSWORD=changeme
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Household timezone. Set this before the first import so photos without an
# EXIF date fall on the right local day.
TZ=America/Chicago

# Timeline -> Immich. Inside Compose the hostname is the service name.
# IMMICH_PUBLIC_URL is the address a phone or laptop uses to open a photo in
# the Immich UI (LAN IP, Tailscale MagicDNS, or a Teleport app URL).
IMMICH_API_KEY=
IMMICH_PUBLIC_URL=http://192.168.1.3:2283
TIMELINE_PAGE_SIZE=48

# Optional. Leave both blank to trust the home network, Tailscale, or Teleport.
TIMELINE_BASIC_AUTH_USER=
TIMELINE_BASIC_AUTH_PASSWORD=

# Other collections, mounted read-only into Immich at the paths below.
# The iCloud download does not use these. ./import-icloud.sh mounts
# ICLOUD_DOWNLOAD_LOCATION for you.
# Do not nest one path inside another.
EXTERNAL_LIBRARY_1=./external/library1
EXTERNAL_LIBRARY_2=./external/library2
EXTERNAL_LIBRARY_3=./external/library3

# Folders another tool syncs with other machines. Leave these commented if
# this machine does not have them. ./add-sync-libraries.sh mounts them
# read-only. Do not use :Z; that private label locks the sync tool out.
# SYNC_PICTURES_LOCATION=/home/funky/sync/pictures
# SYNC_VIDEO_LOCATION=/home/funky/sync/video

# iCloud download. Shared by icloudpd and Immich (:z). ./import-icloud.sh
# writes ICLOUD_USERNAME.
ICLOUD_DOWNLOAD_LOCATION=./data/icloud
ICLOUD_COOKIE_LOCATION=./data/icloud-session
ICLOUD_USERNAME=
ICLOUD_SYNC_INTERVAL=3600
ICLOUD_UNTIL_FOUND=10
